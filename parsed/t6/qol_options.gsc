            b_on = 1;
            self qol_opt_night_on();
        }
        else if ( !b_want && b_on )
        {
            b_on = 0;
            self qol_opt_night_off();
        }

        wait 0.25;
    }
}

qol_opt_night_on()
{
    self setclientdvar( "r_dof_enable", 0 );
    self setclientdvar( "r_enablePlayerShadow", 1 );
    self setclientdvar( "r_skyTransition", 1 );
    self setclientdvar( "sm_sunquality", 2 );
