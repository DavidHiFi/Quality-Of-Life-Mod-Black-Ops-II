qol_opt_roundcounter_master()
{
    level endon( "end_game" );
    n_prev = 1;

    for (;;)
    {
        wait 0.25;
        n_on = getdvarintdefault( "hud_master", 1 );

        if ( !isdefined( level.zmqol_roundcounter ) )
        {
            n_prev = n_on;
            continue;
        }

        if ( !n_on )
        {
            level.zmqol_roundcounter.alpha = 0;
        }
        else if ( !n_prev )
        {
            level.zmqol_roundcounter.alpha = 1;
        }

        n_prev = n_on;
    }
}

qol_opt_lod_fix()
{
    level endon( "end_game" );
    n_prev = -1;

    for (;;)
