material,mc/mtl_t6_attach_scanner_burn
material,mc/mtl_t6_attach_scanner_lens
material,mc/mtl_t6_wpn_launch_xm25
material,mc/mtl_t6_wpn_special_storm
material,mc/mtl_t6_wpn_special_storm_scope
material,mc/mtl_t6_wpn_special_storm_scope_thermal
