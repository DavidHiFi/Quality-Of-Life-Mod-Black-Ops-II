material,mc/mtl_t6_wpn_storm_scope_reticle_sp
material,menu_mp_weapons_metalstorm
material,reticle_side_small_glow

// ---- the Pack-a-Punch camo (see the header - slots 3/8/12 are ours)
camo,camo_metalstorm

// ---- muzzle flashes (small/medium/large, 1st and 3rd person - one pair per
// ---- charge level) and the bullet trail
fx,trail/fx_mstorm_bullet_trail
fx,weapon/muzzleflashes/fx_muz_break_lg_4_sqr
fx,weapon/muzzleflashes/fx_muz_break_md_4_sqr
fx,weapon/muzzleflashes/fx_muz_break_sm_4_sqr
fx,weapon/muzzleflashes/fx_muz_md_gas_flash_1p
fx,weapon/muzzleflashes/fx_muz_md_gas_flash_3p
fx,weapon/muzzleflashes/fx_muz_md_smk
fx,weapon/muzzleflashes/fx_muz_md_smk_3p
fx,weapon/muzzleflashes/fx_muz_mstorm_flash_1p_lg_sp
fx,weapon/muzzleflashes/fx_muz_mstorm_flash_1p_md
fx,weapon/muzzleflashes/fx_muz_mstorm_flash_1p_sm
fx,weapon/muzzleflashes/fx_muz_mstorm_flash_3p_lg_sp
