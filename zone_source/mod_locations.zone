// ============================================================================
//  mod_locations.zone - menu preview + loading screen materials for every
//  Zombies start location offered by ui_mp/t6/zombie/selectmaplistzombie.lua.
//
//  Stock BO2 only ships menu_/loadscreen_ materials for a handful of survival
//  locations (transit, farm, town, nuked). Every other row in the list menu
//  asked the engine for a material that does not exist, which is what drew the
//  checkerboard. These 31 materials fill in the rest.
//
//  Sources: materials/*.json + images/*.iwi under zone_assets/, taken from
//  BO2-Reimagined (user-approved import). Art is per-map, not per-location -
//  Reimagined reuses the parent map's art the same way.
//
//  🛑 A MATERIAL HERE IS ONLY HALF THE ASSET. Declaring it gives mod.ff the
//  material and an image *header*. T6 does NOT store pixel data in the
//  fastfile - it loads that from a loose .iwi at runtime. So every image these
//  materials reference must ALSO exist in the project's images\ folder, which
//  pack_iwd.ps1 packs into mod.iwd. Ship only half and the material resolves,
//  the image asset exists, and it draws BLACK - which is exactly what the first
//  attempt at this did (black Diner loading screen, dark/blank previews).
//  build.bat now syncs zone_assets\images\ -> images\ so the two cannot drift.
// ============================================================================
>game,T6

// --- lobby preview images (menu_<map>_zsurvival_<location>) ---
material,menu_zm_transit_zsurvival_diner
material,menu_zm_transit_zsurvival_power
material,menu_zm_transit_zsurvival_tunnel
material,menu_zm_transit_zsurvival_cornfield
material,menu_zm_highrise_zsurvival_shopping_mall
material,menu_zm_highrise_zsurvival_dragon_rooftop
material,menu_zm_highrise_zsurvival_sweatshop
material,menu_zm_buried_zsurvival_street
material,menu_zm_buried_zsurvival_maze
material,menu_zm_prison_zsurvival_cellblock
material,menu_zm_prison_zsurvival_docks
material,menu_zm_tomb_zsurvival_trenches
material,menu_zm_tomb_zsurvival_excavation_site
material,menu_zm_tomb_zsurvival_church
material,menu_zm_tomb_zsurvival_crazy_place

// --- loading screens (loadscreen_<map>_zstandard_<location>) ---
material,loadscreen_zm_transit_zstandard_diner
material,loadscreen_zm_transit_zstandard_power
material,loadscreen_zm_transit_zstandard_tunnel
material,loadscreen_zm_transit_zstandard_cornfield
material,loadscreen_zm_highrise_zstandard_shopping_mall
material,loadscreen_zm_highrise_zstandard_dragon_rooftop
material,loadscreen_zm_highrise_zstandard_sweatshop
material,loadscreen_zm_buried_zstandard_street
material,loadscreen_zm_buried_zstandard_maze
material,loadscreen_zm_prison_zstandard_cellblock
material,loadscreen_zm_prison_zstandard_docks
material,loadscreen_zm_tomb_zstandard_trenches
material,loadscreen_zm_tomb_zstandard_excavation_site
material,loadscreen_zm_tomb_zstandard_church
material,loadscreen_zm_tomb_zstandard_crazy_place

// Mob of the Dead played as CLASSIC (not a survival location) derives
// loadscreen_zm_prison_zclassic_prison, which stock never shipped either - the
// same gap as the 30 above, just on a stock game mode rather than an added
// location. Reimagined ships it; without it MOTD classic has no loading screen.
material,loadscreen_zm_prison_zclassic_prison

// ============================================================================
//  MODELS THE PORTED LOCATION SCRIPTS SPAWN THAT THEIR MAP DOES NOT SHIP
// ----------------------------------------------------------------------------
//  Established by dumping the xmodel list of all 191 fastfiles in zone/all and
//  searching for every model the scripts/zm/locs/*.gsc setmodel or precache.
//
//  The first four DO exist in the stock game, but only inside the per-gametype
//  "so_" fastfiles, which the engine loads according to the gametype being
//  played:
//      p6_zm_buildable_bench_tarp              so_zsurvival_zm_transit,
//                                              so_zencounter_zm_{transit,prison}
//      zm_collision_transit_cornfield_survival so_zsurvival_zm_transit
//      zm_collision_transit_diner_survival     so_zsurvival_zm_transit,
//                                              so_zencounter_zm_transit, zm_transit_dr
//      p6_zm_al_shock_box_on                   so_zclassic_zm_prison,
//                                              so_zencounter_zm_prison
//
//  There is NO so_zsurvival file for prison, buried, highrise or tomb - stock
//  never had survival on those maps - so on Docks, Trenches, Church and
//  Excavation Site these models are simply absent and precaching them is fatal.
//  Pulling them into mod.ff registers them globally, for every map and mode.
//
//  🛑 This also corrects checkpoint 3, which recorded
//  zm_collision_transit_cornfield_survival as "proven absent from the stock
//  zm_transit fastfile" and had Cornfield's boundary wall deleted on that
//  basis. It was never absent - it was in so_zsurvival_zm_transit all along,
//  and the earlier search simply had not looked at the so_ files.
//
//  The last two exist in NO fastfile anywhere: they are models Reimagined
//  authored (a cut-down plywood sheet and a taller fence post) for the Origins
//  Excavation Site wallbuy hoardings. Built here from its GLB exports.
// ============================================================================
xmodel,p6_zm_buildable_bench_tarp
xmodel,p6_zm_al_shock_box_on
xmodel,zm_collision_transit_cornfield_survival
xmodel,zm_collision_transit_diner_survival
xmodel,p6_pak_old_plywood_small
xmodel,p6_zm_tm_wood_post_thin_01_tall

// ============================================================================
//  MOB OF THE DEAD PLAYER CHARACTERS  -  fixes the invisible-character bug on
//  Docks and Cell Block survival.
// ----------------------------------------------------------------------------
//  🛑 This is the real cause of "invisible body, invisible view arms, invisible
//  weapon, and zombies that cannot damage you". It is NOT a script bug - v1.1.3
//  changed the character set and v1.1.4 added precaching, and NEITHER helped,
//  because the xmodels are not in memory at all.
//
//  Established with the OAT Unlinker, per fastfile:
//      zm_prison.ff             0 player xmodels (only c_zom_cellbreaker_fb)
//      zm_prison_patch.ff       0 player xmodels
//      so_zclassic_zm_prison.ff ALL 8 of the models below
//
//  A zstandard game loads only zm_prison_patch + zm_prison. It loads neither
//  so_zclassic nor so_zencounter, and there is no so_zsurvival_zm_prison.ff -
//  TranZit is the only map in the whole game that ships a so_zsurvival file.
//  So on Docks/Cell Block there is literally no player character asset present.
//  setmodel/setviewmodel still set the .model script field, which is why the
//  in-game probe read model=c_zom_player_deluca_fb and looked perfectly healthy,
//  but nothing renders - and the weapon is invisible too because it hangs off
//  the viewhands tag.
//
//  Pulling them into mod.ff registers them globally, for every map and mode -
//  the same technique already used for p6_zm_al_shock_box_on above, and the same
//  thing BO2-Reimagined does in zone_source\includes\zm_prison.zone.
//  build_ff.bat already --loads so_zclassic_zm_prison.ff, so the Linker can copy
//  them straight out of it; the four bodies are what
//  maps\mp\zm_prison::give_personality_characters sets and the four viewhands are
//  what precache_personality_characters precaches.
// ============================================================================
xmodel,c_zom_player_arlington_fb
xmodel,c_zom_player_deluca_fb
xmodel,c_zom_player_handsome_fb
xmodel,c_zom_player_oleary_fb
xmodel,c_zom_arlington_coat_viewhands
xmodel,c_zom_deluca_longsleeve_viewhands
xmodel,c_zom_handsome_sleeveless_viewhands
xmodel,c_zom_oleary_shortsleeve_viewhands

// ============================================================================
//  BURIED GHOST (the Witch)  -  fixes Maze survival failing to load with
//  COM_ERROR (1) "unknown anim tree 'zm_buried_ghost'".
// ----------------------------------------------------------------------------
//  Same class of gap as the character models. The v1.1.6 fix got Buried survival
//  past the script-link stage (all the mod scripts now report "loaded
//  successfully" in the log), and it then died on the next missing asset:
//
//      Could not load rawfile "animtrees/zm_buried_ghost.atr"
//      COM_ERROR (1): unknown anim tree 'zm_buried_ghost'
//
//  An animtree is resolved at load time by #using_animtree, so this is fatal and
//  cannot be guarded around in script. Per the Unlinker, animtrees/zm_buried_ghost.atr
//  and animstatedefs/zm_buried_ghost.asd exist ONLY in so_zclassic_zm_buried.ff
//  and so_zencounter_zm_buried.ff - neither of which a zstandard game loads, and
//  there is no so_zsurvival_zm_buried.ff.
//
//  build_ff.bat now also --loads so_zclassic_zm_buried.ff so these can be copied
//  out of it. The aitype script and the ghost's xanims come with it, mirroring
//  BO2-Reimagined's zone_source\includes\zm_buried.zone, so the ghost can
//  actually run rather than merely letting the map finish loading.
// ============================================================================
rawfile,animtrees/zm_buried_ghost.atr
rawfile,animstatedefs/zm_buried_ghost.asd
script,aitype/zm_buried_ghost_female.gsc
// aitype/zm_buried_ghost_female.gsc references character\c_zom_zombie_buried_ghost_woman
// for its main()/precache(). Shipping the aitype without it produced, in v1.3.0:
//   Unresolved external: "main"/"precache" with 0 parameters in
//   "aitype/zm_buried_ghost_female.gsc"
// - the same dependency-chain failure as c_buried_player_reporter_dam. The
// character script lives only in so_zclassic/so_zencounter_zm_buried.ff.
script,character/c_zom_zombie_buried_ghost_woman.gsc

// --- Buried player characters (CDC / CIA), same bug as the Alcatraz set above.
//     Maze survival spawned with invisible arms and weapon for exactly this
//     reason. maps\mp\zm_buried::give_team_characters assigns these four, and
//     per the Unlinker they exist ONLY in so_zencounter_zm_buried.ff (note: the
//     ENCOUNTER file, not zclassic like Alcatraz's) - which a zstandard game
//     does not load. build_ff.bat now loads it so these can be copied out.
xmodel,c_zom_player_cdc_dlc1_fb
xmodel,c_zom_player_cia_dlc1_fb
xmodel,c_zom_hazmat_viewhands
xmodel,c_zom_suit_viewhands
